<launch>
  
  <node pkg="yolopkg" type="save_bad_img_node" name="save_bad_img_node" output="screen">
    
    <param name="model_path" value="$(find yolopkg)/best_openvino_model/houli_10_17_yolov5/best"/>
    <param name="conf_threshold" value="0.6"/>
    <param name="cls_threshold" value="0.6"/>
    <param name="iou_threshold" value="0.6"/>
    <param name="way" value="0"/> <!--0: 发送最佳检测结果  1：发送阈值以上的检测结果-->
   
    <param name="image_topic" value="/camera/color/image_raw"/><!-- /camera/map_server  /camera/color/image_raw -->
    
    <param name="queue_size" value="2"/>
    <param name="num_threads" value="2"/>

    <param name="classes_num_" value="31"/>
    <param name="debug_class_" value="24"/>
  </node> 

  <!--<node pkg="basemove" type="basemove_node" name="basemove_node" output="screen"/>-->
  <node pkg="camera" type="intel_image.py" name="intel_image" output="screen"/>
  <!--<node pkg="map_server" type="map_server_node" name="map_server_node" output="screen"/>-->

</launch>